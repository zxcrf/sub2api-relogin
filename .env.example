# 复制为 .env 后按需修改；不建 .env 就用下面的默认值。
# relogin 所在内部网络的网段，和本机已有的 Docker 网络 / 路由冲突时改掉
RELOGIN_SUBNET=172.31.250.0/24
# relogin 容器的固定地址，sub2api 用它访问服务，必须在上面的网段里
RELOGIN_IP=172.31.250.10
# 内部网络网桥在宿主机上的地址，egress 监听在这里，必须在上面的网段里
RELOGIN_GATEWAY=172.31.250.1
# 访问令牌文件（宿主机路径），属主 uid 10790、权限 0400
RELOGIN_TOKEN_PATH=/etc/sub2api-relogin/token
# sub2api 的地址，egress 用它按邮箱查账号配置的代理（只读调用 /api/v1/admin/accounts 和 /proxies/:id）。
# egress 跑在宿主机网络里，sub2api 在本机就填 http://127.0.0.1:<端口>；也可以填公网地址
SUB2API_BASE_URL=
# sub2api 后台「系统设置 → 管理员 API Key」生成的密钥文件（宿主机路径），属主 uid 10790、权限 0400
SUB2API_ADMIN_KEY_PATH=/etc/sub2api-relogin/sub2api-admin-key
# on：登录走账号在 sub2api 里配的代理（账号没配代理就直连）；off：一律从本机出口直连，不查 sub2api
RELOGIN_ACCOUNT_PROXY=on
